<package format="3">
    <name>nav_utils</name>
    <version>1.0.0</version>
    <description>
        Navigation utilities, odometry and tf processing etc.
    </description>
    <maintainer email="tpetricek@gmail.com">Tomas Petricek</maintainer>
    <license>MIT</license>

    <url>https://github.com/tpet/nav_utils</url>
    <author>Tomas Petricek</author>
    <author>Martin Pecka</author>

    <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
    <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>

    <depend>geometry_msgs</depend>
    <depend>nav_msgs</depend>
    <depend condition="$ROS_VERSION == 1">nodelet</depend>
    <depend condition="$ROS_VERSION == 2">rclcpp_components</depend>
    <depend>pcl_conversions</depend>
    <depend>pcl_ros</depend>
    <depend condition="$ROS_VERSION == 1">roscpp</depend>
    <depend condition="$ROS_VERSION == 2">rclcpp</depend>
    <depend>sensor_msgs</depend>
    <depend>std_msgs</depend>
    <depend>tf2</depend>
    <depend>tf2_msgs</depend>
    <depend condition="$ROS_VERSION == 1">tf2_client</depend>
    <depend>tf2_eigen</depend>
    <depend>tf2_ros</depend>
    <depend>topic_tools</depend>
    
    <build_depend condition="$ROS_VERSION == 1">message_generation</build_depend>
    <build_export_depend condition="$ROS_VERSION == 1">message_runtime</build_export_depend>
    <exec_depend condition="$ROS_VERSION == 1">message_runtime</exec_depend>
    
    <exec_depend condition="$ROS_VERSION == 1">rosbag</exec_depend>
    <exec_depend>ros_numpy</exec_depend>

    <export>
        <build_type condition="$ROS_VERSION == 1">catkin</build_type>
        <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
    </export>
</package>

